<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>28.0</SupportedOSPlatformVersion>
    <ApplicationId>com.novolis.mobileexperience.control</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion Condition="'$(NovolisAndroidVersionCode)' != ''">$(NovolisAndroidVersionCode)</ApplicationVersion>
    <ApplicationVersion Condition="'$(ApplicationVersion)' == ''">1</ApplicationVersion>
    <RootNamespace>Novolis.MobileExperience.DeviceControl</RootNamespace>
    <AssemblyName>Novolis.MobileExperience.DeviceControl</AssemblyName>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
